<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration: installer and portable executable.

  Used in the second signing pass, after `electron-builder --prepackaged`.
  Upload a zip containing the NSIS installer and, when present, the portable
  executable. Version numbers are wildcarded so the config survives releases.

  Docs: https://docs.signpath.io/artifact-configuration/syntax
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Qiansi-Setup-*.exe" min-matches="1" max-matches="1">
      <authenticode-sign/>
    </pe-file>
    <pe-file path="Qiansi-*-portable.exe" min-matches="0" max-matches="1">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
